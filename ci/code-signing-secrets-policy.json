{
  "schemaVersion": 1,
  "step": "2.4/6",
  "provider": "SSL.com",
  "service": "eSigner for Code",
  "privateKey": {
    "custody": "SSL.com cloud HSM",
    "exportable": false,
    "presentOnGitHubRunner": false,
    "pfxAllowed": false,
    "repositoryStorageAllowed": false
  },
  "githubActions": {
    "environment": "code-signing-production",
    "environmentProtection": {
      "required": true,
      "requiredReviewersPreferred": true,
      "restrictBranchesOrTags": true,
      "intendedRefs": [
        "release tags",
        "explicitly approved manual release runs"
      ]
    },
    "pullRequestsMayAccessSigningCredentials": false,
    "forksMayAccessSigningCredentials": false,
    "dependabotMayAccessSigningCredentials": false
  },
  "environmentSecrets": [
    {
      "name": "SSL_COM_USERNAME",
      "purpose": "SSL.com account username",
      "required": true
    },
    {
      "name": "SSL_COM_PASSWORD",
      "purpose": "SSL.com account password",
      "required": true
    },
    {
      "name": "SSL_COM_TOTP_SECRET",
      "purpose": "eSigner automation TOTP seed",
      "required": true
    },
    {
      "name": "SSL_COM_CREDENTIAL_ID",
      "purpose": "eSigner signing credential identifier",
      "required": false,
      "availableAfterCertificateIssuance": true
    }
  ],
  "environmentVariables": [
    {
      "name": "SSL_COM_MODE",
      "value": "PROD",
      "sensitive": false
    },
    {
      "name": "SSL_COM_CERT_THUMBPRINT",
      "value": null,
      "sensitive": false,
      "availableAfterCertificateIssuance": true
    }
  ],
  "runnerEphemeralMaterial": {
    "ckaMasterKey": {
      "pathPolicy": "runner-temp-only",
      "persistBetweenJobs": false,
      "uploadAsArtifact": false,
      "commitAllowed": false,
      "cleanupRequired": true
    }
  },
  "logging": {
    "echoSecrets": false,
    "shellTracingWithSecrets": false,
    "uploadRawCKALogs": false,
    "maskDerivedSensitiveValues": true
  },
  "credentialLifecycle": {
    "rotateOnSuspectedExposure": true,
    "rotatePasswordPeriodically": true,
    "rotateTotpOnSuspectedExposure": true,
    "revokeAccessWhenMaintainerLeaves": true
  },
  "oidc": {
    "status": "not-documented-by-selected-provider-for-this-flow",
    "doNotAssumeSupport": true
  },
  "prohibited": [
    "PFX or private key committed to git",
    "PFX encoded into GitHub secrets",
    "SSL.com password committed to files",
    "TOTP seed committed to files",
    "signing credentials exposed to pull_request jobs",
    "raw eSigner CKA logs uploaded by default",
    "persistent CKA master.key on the repository workspace"
  ]
}
